generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  BUYER
  FIELD_WORKER
  ADMIN
  COLLECTION_MANAGER
}

enum BuyerType {
  WHOLESALER
  RETAIL_SHOP
  RESTAURANT
  PROCESSOR
  OTHER
}

enum PriceSource {
  MANUAL
  MARKET_FEED
  SCRAPER
  GOVERNMENT
}

enum DemandStatus {
  DRAFT
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}

enum MatchStatus {
  SUGGESTED
  CONTACTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum QualityGrade {
  PREMIUM
  GRADE_A
  GRADE_B
  GRADE_C
  REJECTED
}

enum ProcessingStage {
  INTAKE
  SORTED
  GRADED
  DRIED
  PACKED
  STORED
  DISPATCHED
  WASTE
}

enum StorageMovementType {
  PUT_AWAY
  TRANSFER_IN
  TRANSFER_OUT
  DISPATCH
  ADJUSTMENT
  LOSS
}

enum FeeStatus {
  PENDING
  PAID
  WAIVED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
  PUSH
  VOICE
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

model User {
  id              String              @id @default(uuid()) @db.Uuid
  phone           String              @unique @db.VarChar(16)
  name            String              @db.VarChar(120)
  role            UserRole
  isActive        Boolean             @default(true)
  phoneVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  farmer          FarmerProfile?
  buyer           BuyerProfile?
  fieldWorker     FieldWorkerProfile?
  otpChallenges   PhoneOtpChallenge[]
  notifications   Notification[]
  feesPaid        FeeCalculation[]    @relation("FeePayer")
  engagement      EngagementEvent[]

  @@index([role, isActive])
}

model PhoneOtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  phone      String    @db.VarChar(16)
  codeHash   String    @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([expiresAt, consumedAt])
}

model Upazila {
  id                String               @id @default(uuid()) @db.Uuid
  code              String               @unique @db.VarChar(20)
  nameEn            String               @db.VarChar(100)
  nameBn            String               @db.VarChar(100)
  districtEn        String               @db.VarChar(100)
  districtBn        String               @db.VarChar(100)
  divisionEn        String               @db.VarChar(100)
  divisionBn        String               @db.VarChar(100)
  latitude          Decimal?             @db.Decimal(9, 6)
  longitude         Decimal?             @db.Decimal(9, 6)
  farmers           FarmerProfile[]
  buyers            BuyerProfile[]
  fieldWorkers      FieldWorkerProfile[]
  collectionCenters CollectionCenter[]
  marketPrices      MarketPrice[]
  forecasts         CropForecast[]
  demandPosts       DemandPost[]
  engagement        EngagementEvent[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([districtEn, nameEn])
}

model Crop {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique @db.VarChar(30)
  nameEn       String             @db.VarChar(80)
  nameBn       String             @db.VarChar(80)
  unit         String             @default("kg") @db.VarChar(16)
  isActive     Boolean            @default(true)
  farmerCrops  FarmerCrop[]
  marketPrices MarketPrice[]
  forecasts    CropForecast[]
  demandPosts  DemandPost[]
  matches      FarmerBuyerMatch[]
  collection   CollectionIntake[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model FarmerProfile {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @unique @db.Uuid
  upazilaId      String             @db.Uuid
  landSizeAcres  Decimal            @db.Decimal(8, 2)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  preferredVoice Boolean            @default(false)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  upazila        Upazila            @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  crops          FarmerCrop[]
  matches        FarmerBuyerMatch[]
  collection     CollectionIntake[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([upazilaId])
}

model FarmerCrop {
  id                String        @id @default(uuid()) @db.Uuid
  farmerId          String        @db.Uuid
  cropId            String        @db.Uuid
  plantedAt         DateTime?     @db.Date
  expectedHarvestAt DateTime?     @db.Date
  areaAcres         Decimal?      @db.Decimal(8, 2)
  expectedYieldKg   Decimal?      @db.Decimal(12, 2)
  farmer            FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop              Crop          @relation(fields: [cropId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([farmerId, cropId])
  @@index([cropId, expectedHarvestAt])
}

model BuyerProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @db.Uuid
  upazilaId    String       @db.Uuid
  buyerType    BuyerType
  businessName String?      @db.VarChar(160)
  address      String?      @db.VarChar(300)
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  upazila      Upazila      @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  demands      DemandPost[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([upazilaId, buyerType])
}

model FieldWorkerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  upazilaId    String   @db.Uuid
  employeeCode String?  @unique @db.VarChar(32)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upazila      Upazila  @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([upazilaId])
}

model MarketPrice {
  id            String      @id @default(uuid()) @db.Uuid
  cropId        String      @db.Uuid
  upazilaId     String      @db.Uuid
  observedAt    DateTime    @db.Date
  source        PriceSource
  marketName    String?     @db.VarChar(120)
  minPriceBdtKg Decimal?    @db.Decimal(12, 2)
  maxPriceBdtKg Decimal?    @db.Decimal(12, 2)
  averageBdtKg  Decimal     @db.Decimal(12, 2)
  currency      String      @default("BDT") @db.VarChar(3)
  crop          Crop        @relation(fields: [cropId], references: [id], onDelete: Restrict)
  upazila       Upazila     @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([cropId, upazilaId, observedAt, source, marketName])
  @@index([upazilaId, observedAt])
  @@index([cropId, observedAt])
}

model CropForecast {
  id               String   @id @default(uuid()) @db.Uuid
  cropId           String   @db.Uuid
  upazilaId        String   @db.Uuid
  forecastDate     DateTime @db.Date
  generatedAt      DateTime @default(now())
  weatherSummaryBn String   @db.VarChar(500)
  weatherSummaryEn String?  @db.VarChar(500)
  minTempC         Decimal? @db.Decimal(5, 2)
  maxTempC         Decimal? @db.Decimal(5, 2)
  rainfallMm       Decimal? @db.Decimal(7, 2)
  rainProbability  Int?
  forecastPriceBdt Decimal? @db.Decimal(12, 2)
  forecastDemandKg Decimal? @db.Decimal(14, 2)
  adviceBn         String?  @db.Text
  source           String   @default("MOCK") @db.VarChar(40)
  crop             Crop     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  upazila          Upazila  @relation(fields: [upazilaId], references: [id], onDelete: Restrict)

  @@unique([cropId, upazilaId, forecastDate, generatedAt])
  @@index([upazilaId, forecastDate])
}

model DemandPost {
  id               String             @id @default(uuid()) @db.Uuid
  buyerId          String             @db.Uuid
  cropId           String             @db.Uuid
  upazilaId        String             @db.Uuid
  quantityKg       Decimal            @db.Decimal(14, 2)
  fulfilledKg      Decimal            @default(0) @db.Decimal(14, 2)
  targetPriceBdtKg Decimal?           @db.Decimal(12, 2)
  deliveryFrom     DateTime?          @db.Date
  deliveryBy       DateTime?          @db.Date
  status           DemandStatus       @default(OPEN)
  notesBn          String?            @db.VarChar(500)
  buyer            BuyerProfile       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  crop             Crop               @relation(fields: [cropId], references: [id], onDelete: Restrict)
  upazila          Upazila            @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  matches          FarmerBuyerMatch[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([cropId, upazilaId, status])
  @@index([status, deliveryBy])
}

model FarmerBuyerMatch {
  id            String           @id @default(uuid()) @db.Uuid
  farmerId      String           @db.Uuid
  demandPostId  String           @db.Uuid
  cropId        String           @db.Uuid
  status        MatchStatus      @default(SUGGESTED)
  matchScore    Decimal          @db.Decimal(5, 2)
  quantityKg    Decimal          @db.Decimal(14, 2)
  proposedPrice Decimal?         @db.Decimal(12, 2)
  contactedAt   DateTime?
  acceptedAt    DateTime?
  farmer        FarmerProfile    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  demandPost    DemandPost       @relation(fields: [demandPostId], references: [id], onDelete: Cascade)
  crop          Crop             @relation(fields: [cropId], references: [id], onDelete: Restrict)
  fees          FeeCalculation[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([farmerId, demandPostId])
  @@index([farmerId, status])
  @@index([demandPostId, status])
}

model CollectionCenter {
  id         String             @id @default(uuid()) @db.Uuid
  nameBn     String             @db.VarChar(120)
  nameEn     String             @db.VarChar(120)
  upazilaId  String             @db.Uuid
  address    String?            @db.VarChar(300)
  capacityKg Decimal?           @db.Decimal(14, 2)
  isActive   Boolean            @default(true)
  upazila    Upazila            @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  intakes    CollectionIntake[]
  movements  StorageMovement[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([upazilaId, isActive])
}

model CollectionIntake {
  id              String            @id @default(uuid()) @db.Uuid
  centerId        String            @db.Uuid
  farmerId        String            @db.Uuid
  cropId          String            @db.Uuid
  receivedAt      DateTime          @default(now())
  receivedKg      Decimal           @db.Decimal(14, 2)
  acceptedKg      Decimal           @db.Decimal(14, 2)
  grade           QualityGrade?
  stage           ProcessingStage   @default(INTAKE)
  dryingStartedAt DateTime?
  dryingEndedAt   DateTime?
  packedAt        DateTime?
  batchCode       String?           @unique @db.VarChar(40)
  notesBn         String?           @db.VarChar(500)
  center          CollectionCenter  @relation(fields: [centerId], references: [id], onDelete: Restrict)
  farmer          FarmerProfile     @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  crop            Crop              @relation(fields: [cropId], references: [id], onDelete: Restrict)
  movements       StorageMovement[]
  fees            FeeCalculation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([centerId, receivedAt])
  @@index([farmerId, receivedAt])
}

model StorageMovement {
  id         String              @id @default(uuid()) @db.Uuid
  centerId   String              @db.Uuid
  intakeId   String              @db.Uuid
  movement   StorageMovementType
  quantityKg Decimal             @db.Decimal(14, 2)
  location   String?             @db.VarChar(80)
  occurredAt DateTime            @default(now())
  notes      String?             @db.VarChar(300)
  center     CollectionCenter    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  intake     CollectionIntake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([centerId, occurredAt])
  @@index([intakeId, occurredAt])
}

model FeeCalculation {
  id             String            @id @default(uuid()) @db.Uuid
  matchId        String?           @db.Uuid
  intakeId       String?           @db.Uuid
  payerId        String            @db.Uuid
  basisAmountBdt Decimal?          @db.Decimal(14, 2)
  commissionRate Decimal           @db.Decimal(5, 2)
  commissionBdt  Decimal           @default(0) @db.Decimal(14, 2)
  serviceFeeBdt  Decimal           @default(0) @db.Decimal(14, 2)
  totalFeeBdt    Decimal           @db.Decimal(14, 2)
  status         FeeStatus         @default(PENDING)
  calculatedAt   DateTime          @default(now())
  paidAt         DateTime?
  match          FarmerBuyerMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  intake         CollectionIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  payer          User              @relation("FeePayer", fields: [payerId], references: [id], onDelete: Restrict)

  @@index([payerId, status])
  @@index([calculatedAt])
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  channel       NotificationChannel
  status        NotificationStatus  @default(QUEUED)
  titleBn       String?             @db.VarChar(160)
  bodyBn        String              @db.Text
  voiceAssetUrl String?             @db.VarChar(500)
  scheduledAt   DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failureCode   String?             @db.VarChar(80)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())

  @@index([userId, status, createdAt])
  @@index([channel, status, scheduledAt])
}

model EngagementEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  upazilaId  String?  @db.Uuid
  eventType  String   @db.VarChar(60)
  metadata   Json?
  occurredAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  upazila    Upazila? @relation(fields: [upazilaId], references: [id], onDelete: SetNull)

  @@index([upazilaId, eventType, occurredAt])
  @@index([userId, occurredAt])
}
